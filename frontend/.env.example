# Development-only origin used by Vite to proxy existing PHP requests.
# It is not embedded as a credential and it does not create a UI BFF.
VITE_DEV_PHP_ORIGIN=http://localhost:8080

# Public defaults. A future thin same-origin host may inject these values at runtime.
VITE_DEFAULT_BASE_URL=/
VITE_DEFAULT_APP_PATH=app/
VITE_DEFAULT_LOCALE=en-GB
VITE_DEFAULT_TIMEZONE=UTC
