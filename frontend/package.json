{
  "name": "freeitsm-react-eui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:structure": "node scripts/verify-structure.mjs",
    "verify:isolation": "node scripts/verify-isolation.mjs",
    "verify:lockfile": "node scripts/verify-lockfile.mjs",
    "verify": "npm run verify:structure && npm run verify:isolation && npm run verify:lockfile && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@elastic/datemath": "5.0.3",
    "@elastic/eui": "119.0.0",
    "@elastic/eui-theme-borealis": "8.0.0",
    "@emotion/css": "11.13.5",
    "@emotion/react": "11.14.0",
    "moment": "2.30.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "22.10.2",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "jsdom": "29.1.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.60.1",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
