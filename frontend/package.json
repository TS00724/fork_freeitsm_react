{
  "name": "freeitsm-react-eui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^20.19.0 || ^22.13.0 || >=24.0.0" },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:test": "node scripts/serve-dist.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "verify:structure": "node scripts/verify-structure.mjs",
    "verify:isolation": "node scripts/verify-isolation.mjs",
    "verify:lockfile": "node scripts/verify-lockfile.mjs",
    "verify:preview": "node scripts/verify-preview.mjs",
    "verify": "npm run verify:structure && npm run verify:isolation && npm run verify:lockfile && npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run verify:preview"
  },
  "dependencies": {
    "@elastic/datemath": "5.0.3",
    "@elastic/eui": "119.0.0",
    "@elastic/eui-theme-borealis": "8.0.0",
    "@emotion/css": "11.13.5",
    "@emotion/react": "11.14.0",
    "moment": "2.30.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "22.20.1",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "jsdom": "29.1.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.60.1",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "overrides": {
    "prismjs": "1.30.0"
  }
}
